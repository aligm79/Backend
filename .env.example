# Copy to `.env` and adjust. Every key here is optional unless commented —
# sensible defaults live in src/dmp/config.py.

# ---------- Addresses ----------
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=Development

# ---------- PostgreSQL ----------
# POSTGRES_* boot the db container in compose AND build DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dmp_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dmp_dev

# Apply `alembic upgrade head` on boot.
DATABASE__AUTO_MIGRATE=true

# ---------- Auth / JWT ----------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Admin seed ----------
AUTO_CREATE_DEFAULT_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@Admin1234

# ---------- OTP (phone verification) ----------
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=5

# ---------- Redis (optional — cache / queues when enabled) ----------
# e.g. redis://localhost:6379/0 (or redis://redis:6379/0 inside compose)
REDIS_URL=

# ---------- Kavenegar SMS (optional — OTP delivery) ----------
# Key from https://panel.kavenegar.com; empty = SMS disabled.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=

# ---------- Zarinpal payment gateway ----------
# MODE: sandbox | payment. Merchant UUID from https://panel.zarinpal.com.
ZARINPAL__MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL__MODE=sandbox
ZARINPAL__CALLBACK_URL=http://localhost:5173/payment-result

# ---------- Misc ----------
DOCS_ENABLED=true
UPLOADS_DIR=uploads
