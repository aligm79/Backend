# Copy to `.env` and adjust. See README.md for the full list.

# Where the API listens (host port mapping in compose).
BACKEND_PORT=8000
# Where the frontend is reachable (CORS allow-list).
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database (bare-metal dev default; compose overrides the host to `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dmp_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dmp_dev

# Apply `alembic upgrade head` on boot.
DATABASE__AUTO_MIGRATE=true

# Auth / seeded admin (JWT key MUST be >= 32 UTF-8 bytes in production).
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
AUTO_CREATE_DEFAULT_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@Admin1234

DOCS_ENABLED=true
UPLOADS_DIR=uploads
